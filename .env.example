# ===== 会议号池配置示例 =====
# 复制为 .env 后修改。密钥类内容不要提交到 Git。

# 监听地址（内网使用建议保持 127.0.0.1，由 Nginx 反代）
POOL_HOST=127.0.0.1
POOL_PORT=8099

# 管理后台账号
POOL_ADMIN_USER=admin
POOL_ADMIN_PASSWORD=请改成你自己的强密码


# 存储位置（默认 ./data/pool.db）
# POOL_DB_PATH=./data/pool.db

# 主密钥：用于加密账号 Token。留空则首次启动自动生成到 .pool_secret
# 生成方式：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
POOL_MASTER_KEY=

# ===== 腾讯会议 MCP 接入 =====
# 官方 Token 领取页：https://meeting.tencent.com/ai-skill.html
# 每个号池账号对应一个 Token，填在管理后台「新增账号」里，加密落库
# 端点已按官方 config.json 核对：baseUrl = https://mcp.meeting.tencent.com/mcp/wemeet-open/v1
POOL_MCP_URL=https://mcp.meeting.tencent.com/mcp/wemeet-open/v1
POOL_MCP_TOOL=schedule_meeting
POOL_MCP_CANCEL_TOOL=cancel_meeting
POOL_MCP_LIST_TOOL=get_user_meetings
POOL_MCP_TOKEN_HEADER=X-Tencent-Meeting-Token
POOL_MCP_SKILL_VERSION=v1.0.14
# 参数模板，占位符：{subject} {start} {end} {password} {timezone}
# 注意官方字段是 time_zone（带下划线）；_client_info 由代码自动注入
POOL_MCP_ARGS={"subject":"{subject}","start_time":"{start}","end_time":"{end}","password":"{password}","time_zone":"{timezone}","auto_record_type":"{record_type}","auto_in_waiting_room":"{waiting}"}
POOL_MCP_TIMEOUT=20
